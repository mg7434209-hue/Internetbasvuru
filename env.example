# =============================================
# internetbasvuru.com — Environment Variables
# =============================================
# Bu dosyayı .env.local olarak kopyalayıp doldurun.
# Production'da Railway environment variables'a ekleyin.
#
# Hiçbiri zorunlu değil — yokken site çalışır, sadece o
# özellik devre dışı kalır.

# =============================================
# ANALYTICS — Google Analytics 4
# =============================================
# Format: G-XXXXXXXXXX
# Yer: GA4 → Admin → Data Streams → Web → Measurement ID
# Yoksa: Analytics tamamen devre dışı kalır
NEXT_PUBLIC_GA4_ID=

# =============================================
# GOOGLE ADS — Conversion Tracking
# =============================================
# Format: AW-XXXXXXXXXX
# Yer: Google Ads → Tools → Conversions → New conversion
NEXT_PUBLIC_GADS_CONVERSION_ID=

# Format: aBcDeFgHiJk (kısa label)
# Yer: Google Ads → Conversion Action → Tag setup
NEXT_PUBLIC_GADS_LEAD_LABEL=

# =============================================
# GOOGLE SEARCH CONSOLE
# =============================================
# Format: meta tag content (örn. abc123def456...)
# Yer: Search Console → Settings → Verification
# Yoksa: meta tag eklenmez
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# =============================================
# BAYI BİLGİLERİ (Backend için)
# =============================================
# WhatsApp link için kullanılır (footer ve iletişim)
# Format: 905XXXXXXXXX (90 ile başlayan, + olmadan)
NEXT_PUBLIC_WHATSAPP_NUMBER=905349777000

# =============================================
# GESPA OS — başvuru defteri (isteğe bağlı)
# =============================================
# Yeni başvurunun KİŞİSEL VERİSİZ özeti (il, ilçe, paket, kaynak, kapsama)
# Gespa OS'e gönderilir. Ad, telefon, adres GÖNDERİLMEZ.
# İkisi de yoksa özellik kapalıdır.
OS_INGEST_URL=
# Gespa OS'teki ORDER_INGEST_TOKEN ile AYNI değer (en az 32 karakter)
OS_INGEST_TOKEN=
